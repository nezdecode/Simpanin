#!/bin/sh
# Refreshes graphify's code graph after each commit, in the background, where graphify is installed and a
# graph has been built (graphify-out/). Otherwise it does nothing, and it never fails a commit.
# Install once per clone: git config core.hooksPath scripts/hooks
command -v graphify > /dev/null 2>&1 && [ -d graphify-out ] && [ -x /usr/bin/lockf ] || exit 0

# One update at a time: two writers could break graph.json, and rebuilding it costs tokens. lockf holds a
# kernel lock while the update runs, released when it exits, even by a crash, so no lock is ever left
# behind. Each commit leaves a mark; an update runs until no mark is left, so a commit made while one runs,
# as in a rebase, still gets graphed.
# shortcut: a commit landing just as an update has found no mark, but before it exits, waits for the next
# commit to be graphed.
lock="$(git rev-parse --git-path graphify-update.flock)"
mark="$(git rev-parse --git-path graphify-update.again)"
log="$(git rev-parse --git-path graphify-update.log)"

if [ "${1:-}" = update ]; then
  while [ -e "$mark" ]; do
    rm -f "$mark"
    # graphify refuses a graph with fewer nodes; after deleting code, run `graphify update . --force`.
    graphify update . > "$log" 2>&1
  done
  exit 0
fi

touch "$mark"
# -t 0: when an update already holds the lock, give up at once; that update will see the mark.
/usr/bin/lockf -k -s -t 0 "$lock" sh "$0" update < /dev/null > /dev/null 2>&1 &
exit 0
