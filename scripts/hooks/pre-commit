#!/bin/sh
# Rejects any staged image or PDF outside Fixtures/Synthetic/, and the
# private docs/ folder, CLAUDE.md and .claude/. Checks staged Swift files with swift-format
# and SwiftLint.
# Real document scans must never be committed; see .gitignore.
# Install once per clone: git config core.hooksPath scripts/hooks

bad=$(git diff --cached --name-only --diff-filter=ACMR -z \
  | tr '\0' '\n' \
  | grep -iE '\.(jpe?g|png|heic|pdf)$' \
  | grep -v '^Fixtures/Synthetic/')

if [ -n "$bad" ]; then
  echo "pre-commit: refusing to commit images or PDFs outside Fixtures/Synthetic/:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  echo "Unstage them with: git rm --cached <file>" >&2
  exit 1
fi
private=$(git diff --cached --name-only --diff-filter=ACMR -z \
  | tr '\0' '\n' \
  | grep -E '^(docs/|\.claude/|CLAUDE\.md$)')

if [ -n "$private" ]; then
  echo "pre-commit: refusing to commit private files (docs/, .claude/, CLAUDE.md):" >&2
  echo "$private" | sed 's/^/  /' >&2
  echo "Unstage them with: git rm --cached <file>" >&2
  exit 1
fi

# Staged Swift files must pass swift-format (layout) and SwiftLint (naming, size, headers,
# VaultCore imports). The working-tree copy is checked, so stage whole files.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
swift_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')
if [ -n "$swift_files" ]; then
  if ! command -v swiftlint >/dev/null 2>&1; then
    echo "pre-commit: SwiftLint is not installed. Install it with: brew install swiftlint" >&2
    exit 1
  fi
  if ! printf '%s\n' "$swift_files" | tr '\n' '\0' | xargs -0 swift format lint --strict; then
    echo "pre-commit: swift-format found layout problems. Fix them with: swift format format -i <file>" >&2
    exit 1
  fi
  # Package.swift is excluded in .swiftlint.yml; with no other file left, skip SwiftLint.
  lint_files=$(printf '%s\n' "$swift_files" | grep -v '\(^\|\/\)Package\.swift$')
  if [ -n "$lint_files" ] && ! printf '%s\n' "$lint_files" | tr '\n' '\0' | xargs -0 swiftlint lint --strict --quiet; then
    echo "pre-commit: SwiftLint found problems (see above)." >&2
    exit 1
  fi
  # The app's folder rules: which layer and feature may use which (CODING.md section 1).
  if ! python3 scripts/check-folder-rules.py; then
    echo "pre-commit: a file crosses the folder rules (see above)." >&2
    exit 1
  fi
fi
exit 0
